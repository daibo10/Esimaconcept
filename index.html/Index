                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 2: Water Treatment -->
            <div class="slide">
                <svg class="slide-bg" viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
                    <rect width="800" height="600" fill="#050D1E"/>
                    <rect x="200" y="100" width="120" height="400" rx="20" fill="#162C5B"/>
                    <rect x="480" y="100" width="120" height="400" rx="20" fill="#162C5B"/>
                    <circle cx="260" cy="200" r="40" fill="#10B981" opacity="0.5"/>
                    <circle cx="540" cy="200" r="40" fill="#10B981" opacity="0.5"/>
                </svg>
                <div class="container">
                    <div class="slide-content">
